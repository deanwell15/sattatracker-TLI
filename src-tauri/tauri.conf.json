{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deanfinite",
  "version": "1.2.11",
  "identifier": "io.github.deanwell15.deanfinite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deanfinite",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "deanwell15",
    "shortDescription": "Deanfinite — Torchlight: Infinite Loot Tracker",
    "windows": {
      "wix": {
        "upgradeCode": "849ca07a-a9b1-5a63-a3dd-ada5058d0f97"
      }
    }
  },
  "mainBinaryName": "Deanfinite"
}
